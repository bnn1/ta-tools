{
  "name": "@bnn1/ta-tools",
  "version": "0.2.3",
  "description": "Blazing fast technical analysis indicators powered by Rust/WASM",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "pkg/ta_core.js",
    "pkg/ta_core.d.ts",
    "pkg/ta_core_bg.wasm",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:wasm": "wasm-pack build crates/ta-core --target nodejs --out-dir ../../pkg --out-name ta_core",
    "build:js": "tsup",
    "build": "pnpm run build:wasm && pnpm run build:js",
    "test": "pnpm run build && pnpm exec vitest run",
    "test:built": "pnpm exec vitest run",
    "bench": "pnpm run build && pnpm exec vitest bench",
    "bench:built": "pnpm exec vitest bench",
    "pack:check": "pnpm pack --dry-run",
    "prepublishOnly": "pnpm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bnn1/ta-tools.git"
  },
  "homepage": "https://github.com/bnn1/ta-tools#readme",
  "bugs": {
    "url": "https://github.com/bnn1/ta-tools/issues"
  },
  "author": "bnn1",
  "engines": {
    "node": ">=26.0.0"
  },
  "keywords": [
    "technical-analysis",
    "trading",
    "indicators",
    "wasm",
    "rust"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.1",
    "fast-technical-indicators": "^1.1.4",
    "indicatorts": "^2.2.2",
    "trading-signals": "^8.2.0",
    "tsup": "8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
